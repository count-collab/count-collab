# Count Collab - Environment Variables

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/count_collab

# Application
NODE_ENV=development
PUBLIC_API_URL=http://localhost:5173

# Server
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Auth.js
AUTH_SECRET=          # Generate with: openssl rand -base64 33
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
AUTH_TWITCH_ID=
AUTH_TWITCH_SECRET=

// PostHog Analytics
PUBLIC_POSTHOG_PROJECT_TOKEN=
PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
