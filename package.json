{
  "name": "count-collab",
  "version": "0.8.0",
  "description": "Count Collab - Shared counts that everyone can use",
  "type": "module",
  "scripts": {
    "dev": "node scripts/generate-build-info.js && vite dev",
    "build": "node scripts/generate-build-info.js && svelte-kit sync && vite build",
    "preview": "vite preview",
    "svelte-prepare": "svelte-kit sync",
    "svelte-check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "biome ci --error-on-warnings .",
    "fix": "biome check --write .",
    "format": "prettier --plugin-search-dir . --write .",
    "db:init": "bun run scripts/seed-counters.ts",
    "db:delete-counters": "bun run scripts/delete-counters.ts",
    "db:seed-roles": "bun run scripts/seed-roles.ts",
    "db:push": "drizzle-kit push:pg",
    "db:migrate": "bun run scripts/migrate.ts",
    "db:generate": "drizzle-kit generate:pg",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "playwright:install": "bunx playwright install chromium"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@auth/sveltekit": "^1.11.3",
    "@resvg/resvg-js": "^2.6.2",
    "@sveltejs/adapter-node": "^5.5.8",
    "@sveltejs/kit": "^2.70.4",
    "chart.js": "^4.6.1",
    "drizzle-orm": "^0.45.4",
    "ionicons": "^8.1.0",
    "lru-cache": "^11.5.3",
    "postgres": "^3.4.9",
    "posthog-js": "^1.447.12",
    "posthog-node": "^5.69.0",
    "satori": "^0.26.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "svelte": "^5.57.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "~2.6.6",
    "@fontsource/inter": "^5.3.0",
    "@playwright/test": "^1.65.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@testing-library/jest-dom": "~6.9.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^20.19.43",
    "@types/ws": "^8.18.2",
    "autoprefixer": "^10.6.2",
    "drizzle-kit": "^0.20.18",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.32",
    "prettier": "^3.10.0",
    "prettier-plugin-svelte": "^3.5.2",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20.0.0",
    "bun": "^1.4.4"
  }
}