{
  "name": "count-collab",
  "version": "0.8.0",
  "description": "Count Collab - Shared counts that everyone can use",
  "type": "module",
  "scripts": {
    "dev": "node scripts/generate-build-info.js && vite dev",
    "build": "node scripts/generate-build-info.js && svelte-kit sync && vite build",
    "preview": "vite preview",
    "svelte-prepare": "svelte-kit sync",
    "svelte-check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "biome ci --error-on-warnings .",
    "fix": "biome check --write .",
    "format": "prettier --plugin-search-dir . --write .",
    "db:init": "bun run scripts/seed-counters.ts",
    "db:delete-counters": "bun run scripts/delete-counters.ts",
    "db:seed-roles": "bun run scripts/seed-roles.ts",
    "db:push": "drizzle-kit push:pg",
    "db:migrate": "bun run scripts/migrate.ts",
    "db:generate": "drizzle-kit generate:pg",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "playwright:install": "bunx playwright install chromium"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@auth/sveltekit": "^1.11.3",
    "@resvg/resvg-js": "^2.6.2",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.3",
    "chart.js": "^4.5.1",
    "drizzle-orm": "^0.45.4",
    "ionicons": "^8.0.13",
    "lru-cache": "^11.2.7",
    "postgres": "^3.4.0",
    "posthog-js": "^1.438.9",
    "posthog-node": "^5.55.3",
    "satori": "^0.26.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "svelte": "^5.57.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "~2.4.4",
    "@fontsource/inter": "^5.2.8",
    "@playwright/test": "^1.58.2",
    "@sveltejs/vite-plugin-svelte": "^6",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.10",
    "autoprefixer": "^10.4.0",
    "drizzle-kit": "^0.20.0",
    "jsdom": "^29.0.0",
    "postcss": "^8.5.30",
    "prettier": "^3.0.0",
    "prettier-plugin-svelte": "^3.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.0.0",
    "vite": "^7",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "bun": "^1.4.4"
  }
}