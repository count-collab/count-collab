#!/bin/bash
# Pre-commit hook to run code formatting and linting

set -e

# Ensure common tool paths are available (hooks run with minimal PATH)
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

echo "Running 'bun run fix' before commit..."
bun run fix

echo "Running 'bun run lint' before commit..."
bun run lint
if [ $? -ne 0 ]; then
    echo "❌ 'bun run lint' failed. Fix all errors and warnings before committing."
    exit 1
fi

echo "✓ Code formatting and linting passed. Proceeding with commit."
exit 0
